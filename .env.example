# --- Базы данных ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

CH_USER=
CH_PASSWORD=
CH_DB=

# --- Langfuse ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=
TELEMETRY_ENABLED=
ENCRYPTION_KEY=
SALT=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://langfuse:3000
# true только вместе с `make debug-up` (иначе API отключит трейсинг сам)
LANGFUSE_ENABLE_TRACE=true
# UI: email/password. Полностью без логина Langfuse не умеет — headless-аккаунт:
AUTH_DISABLE_USERNAME_PASSWORD=false
LANGFUSE_INIT_ORG_ID=warhammer
LANGFUSE_INIT_ORG_NAME=Warhammer Wiki Bot
LANGFUSE_INIT_PROJECT_ID=warhammer-rag
LANGFUSE_INIT_PROJECT_NAME=RAG
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=adminadmin

# --- Модели и AI ---
EMBEDDING_MODEL_ID=
LLM_PROVIDER=
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL_NAME=
# Bearer-токен для локального gigachat-adapter (свой, не публикуй)
GIGACHAT_ADAPTER_BEARER_TOKEN=

# openrouter: используется, если LLM_PROVIDER=openrouter, а также всегда
# нужен для роли judge ниже (у неё дефолтный провайдер — openrouter,
# независимо от LLM_PROVIDER) — без ключа эвал-судья работать не будет,
# даже если сам бот отвечает через gigachat.
OPENROUTER_API_KEY=
LLM_MODEL_NAME=

# --- Модель по задаче (опционально) ---
# Пусто = наследовать LLM_PROVIDER/GIGACHAT_MODEL_NAME (или LLM_MODEL_NAME для openrouter)
# выше. Позволяет назначить более сильную/слабую или локальную модель под
# конкретную задачу без изменения кода. LightRAG (граф) — отдельный сервис,
# настраивается своими LLM_BINDING_HOST/LLM_MODEL ниже, сюда не относится.
ROUTER_LLM_PROVIDER=
ROUTER_LLM_MODEL=
GENERATION_LLM_PROVIDER=
GENERATION_LLM_MODEL=
FAITHFULNESS_LLM_PROVIDER=
FAITHFULNESS_LLM_MODEL=

# --- Judge (LLM-as-judge для эвала, app/eval/evaluate_generation.py) ---
# В отличие от полей выше, тут пусто НЕ значит "наследовать LLM_PROVIDER" —
# дефолт из config.py уже openrouter + бесплатная модель (":free"), чтобы
# судья не совпадал с generation-моделью (self-bias) и не стоил денег.
# Бесплатные модели OpenRouter иногда меняются — проверить актуальные:
# https://openrouter.ai/models?max_price=0
JUDGE_LLM_PROVIDER=
JUDGE_LLM_MODEL=

# --- Rate limiting ---
# Пусто = дефолты из config.py (RATE_LIMIT_ENABLED=true, RATE_LIMIT_ASK=20/minute)
RATE_LIMIT_ENABLED=
RATE_LIMIT_ASK=

# --- Порты (если захотите изменить) ---
API_PORT=
LANGFUSE_PORT=
TEI_PORT=
QDRANT_PORT=
REDIS_PORT=
CHAINLIT_PORT=8501
